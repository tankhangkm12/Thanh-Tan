{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentflow workflow",
  "description": "Workflow a plugin family declares for agentflow. Steps run in list order; a failed step with on_fail goes back to that earlier step, at most max_rounds times per task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "family", "max_rounds", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "family": { "$ref": "#/$defs/identifier" },
    "max_rounds": { "type": "integer", "minimum": 1 },
    "tiered_roles": {
      "type": "array",
      "uniqueItems": true,
      "description": "Roles that have one agent per plan-item tier (<role>-fast, <role>-deep). Other roles have a single agent.",
      "items": { "$ref": "#/$defs/identifier" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/identifier" },
        "requires_approval": { "type": "boolean", "default": false },
        "on_fail": { "$ref": "#/$defs/identifier" },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["plan-valid", "scans-clean", "conventions-reviewed"] }
        }
      }
    }
  }
}
