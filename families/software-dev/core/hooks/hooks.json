{
  "description": "agentflow hooks: block risky git commands, load the task summary at session start, remind about task state on stop. They do nothing in projects without .agentflow/.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentflow",
            "args": ["hook", "session-start", "--cli", "claude"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "agentflow",
            "args": ["hook", "pre-tool", "--cli", "claude"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentflow",
            "args": ["hook", "stop", "--cli", "claude"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
